---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, projectCategories } from "../data/projects";
import Icon from "../components/Icon.astro";
import ProjectImage from "../components/ProjectImage.astro";
import ProjectCorridor from "../components/immersive/ProjectCorridor.astro";

/* Pair photo slugs (or null → placeholder type-card) and lowercase category
   keys for the JS filter. */
const cardData = projects.map((p) => ({
  ...p,
  filter: p.category.toLowerCase(),
}));
---

<BaseLayout
  title="Projects"
  description="Selected commercial projects framed and finished by Nirvana Construction across Maryland, including ALDI, Chipotle, Golf Galaxy, JCC, MACE Medical and more."
>
  <main class="blueprint-bg min-h-screen">
    {/* ============ Hero: the 3D corridor past the real work ============ */}
    <ProjectCorridor />

    {/* ============ Filter ============ */}
    <section class="max-w-container-max mx-auto px-lg mb-xl">
      <div class="flex flex-wrap gap-md items-center">
        <span class="font-label-bold text-label-bold text-on-surface-variant uppercase mr-sm">
          Filter Projects:
        </span>
        <button
          class="filter-btn active px-lg py-sm font-button text-button uppercase border-2 border-primary bg-primary text-on-primary transition-all duration-200"
          data-filter="all"
        >
          All
        </button>
        {projectCategories.map((cat) => (
          <button
            class="filter-btn px-lg py-sm font-button text-button uppercase border-2 border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all duration-200"
            data-filter={cat.toLowerCase()}
          >
            {cat}
          </button>
        ))}
      </div>
    </section>

    {/* ============ Project grid ============ */}
    <section class="max-w-container-max mx-auto px-lg pb-xxl">
      <div id="project-grid" class="pj-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {cardData.map((p, i) => (
          <article
            id={p.slug}
            data-rise
            class="project-card"
            data-category={p.filter}
          >
            {/* the face flips on filter changes; the shell rises with scroll */}
            <div class:list={["pj-face group", i === 1 && "pj-accent"]}>
              <div class="relative overflow-hidden h-64">
                {p.photo ? (
                  <ProjectImage
                    slug={p.photo}
                    class="pj-photo w-full h-full object-cover"
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    alt={p.location ? `${p.name}, ${p.location}` : p.name}
                  />
                ) : (
                  <div class="pj-blueprint" role="img" aria-label={`${p.name}: photographs to follow`}>
                    <span class="pj-bp-icon"><Icon name="apartment" strokeWidth={1.25} /></span>
                    <p class="pj-bp-name">{p.name}</p>
                    <p class="pj-bp-note">Photographs to follow</p>
                  </div>
                )}
                <span class="pj-shade" aria-hidden="true" />
                <div class="absolute top-0 right-0 bg-secondary text-on-primary px-md py-xs font-label-bold text-label-bold uppercase">
                  {p.category}
                </div>
              </div>
              <div class="p-lg">
                <h3 class="font-headline-md text-headline-md text-primary mb-xs">{p.name}</h3>
                {
                  p.location && (
                    <div class="flex items-center gap-xs text-on-surface-variant font-body-sm">
                      <Icon name="location_on" style="font-size: 18px;" />
                      <span>{p.location}</span>
                    </div>
                  )
                }
                <p class="mt-sm font-body-sm text-body-sm text-on-surface-variant">{p.descriptor}</p>
                <div class="mt-md pt-md border-t border-outline-variant flex justify-between items-center">
                  <span class="font-label-bold text-label-bold text-primary uppercase">View Details</span>
                  <Icon name="arrow_forward" class="pj-arrow text-secondary" />
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ============ CTA ============ */}
    <section class="bg-primary text-on-primary py-xxl">
      <div class="max-w-container-max mx-auto px-lg text-center">
        <h2 class="font-headline-lg text-headline-lg mb-md">Have a project on the boards?</h2>
        <p class="font-body-lg text-body-lg text-on-primary-container max-w-[36rem] mx-auto mb-xl">
          Send drawings, a few notes about the scope and a target start date,
          and we'll be in touch.
        </p>
        <div class="flex flex-col md:flex-row justify-center items-center gap-lg">
          <a
            data-magnetic
            href="/contact/"
            class="inline-flex items-center gap-sm bg-secondary text-on-primary px-xxl py-md font-button text-button uppercase hover:bg-secondary-container hover:text-on-secondary-container transition-all shadow-lg"
          >
            <Icon name="mail" />
            Get in Touch
          </a>
          <a
            href="/services/"
            class="inline-flex items-center gap-sm border-2 border-on-primary text-on-primary px-xxl py-md font-button text-button uppercase hover:bg-on-primary hover:text-primary transition-all"
          >
            View Services
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  /* the corridor asks for "All" before it scrolls to a card, so a
     click on ALDI never lands on a card the Medical filter has hidden */
  let resetBound = false;
  function bindReset() {
    if (resetBound) return;
    resetBound = true;
    document.addEventListener("nv:reset-filter", () => {
      document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="all"]:not(.active)')?.click();
    });
  }

  /* filtering turns cards out and back in on their vertical axis, in a
     short cascade; reduced motion simply shows and hides them */
  const timers: number[] = [];
  function setupFilter() {
    bindReset();
    const grid = document.getElementById("project-grid") as (HTMLElement & { __pjBound?: boolean }) | null;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const projectCards = [...document.querySelectorAll<HTMLElement>(".project-card")];
    if (!grid || !filterBtns.length || grid.__pjBound) return;
    grid.__pjBound = true;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const f = btn.getAttribute("data-filter") || "all";

        filterBtns.forEach((b) => {
          b.classList.remove("active", "bg-primary", "text-on-primary", "border-primary");
          b.classList.add("border-outline-variant", "text-on-surface-variant");
        });
        btn.classList.remove("border-outline-variant", "text-on-surface-variant");
        btn.classList.add("active", "bg-primary", "text-on-primary", "border-primary");

        timers.splice(0).forEach((t) => window.clearTimeout(t));
        const show = projectCards.filter((c) => f === "all" || c.dataset.category === f);
        if (reduced) {
          projectCards.forEach((c) => (c.hidden = !show.includes(c)));
          return;
        }
        /* 1: everything visible turns away */
        projectCards.forEach((c) => {
          if (!c.hidden) c.classList.add("pj-out");
        });
        timers.push(
          window.setTimeout(() => {
            /* 2: swap the set, then turn the new set back in, one by one */
            projectCards.forEach((c) => {
              c.hidden = !show.includes(c);
              c.classList.remove("pj-out");
              if (!c.hidden) c.classList.add("pj-in");
            });
            show.forEach((c, i) =>
              timers.push(window.setTimeout(() => c.classList.remove("pj-in"), 40 + i * 60)),
            );
            window.dispatchEvent(new Event("scroll"));
          }, 380),
        );
      });
    });
  }
  setupFilter();
  document.addEventListener("astro:page-load", setupFilter);
</script>

<style>
  /* a corridor click lands here: a brief orange frame that fades. It lives
     on ::after so the card's own [data-reveal] opacity/transform transition
     (and the filter's inline transition) are left untouched. */
  /* each card carries its own perspective. It used to sit on the grid, whose
     vanishing point is the grid's centre: in one column the grid is ~7600px
     tall, so a card rising near the fold was projected toward a point
     thousands of pixels away and squashed to a line on phones. */
  .project-card { position: relative; perspective: 1200px; }
  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    border: 3px solid #ff6600;
    opacity: 0;
    transition: opacity 1.8s ease;
  }
  .project-card:global(.nv-flash)::after { opacity: 1; transition: opacity 0.2s ease; }

  /* ---- the card face ---- */
  .pj-face {
    height: 100%;
    overflow: hidden;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid var(--color-hairline);
    box-shadow: 0 1px 2px rgba(10, 31, 20, 0.06);
    transform: rotateY(0deg);
    transition:
      transform 0.55s cubic-bezier(0.2, 0.7, 0, 1),
      opacity 0.4s ease,
      box-shadow 0.4s ease;
  }
  .pj-accent { border-top: 4px solid var(--color-secondary); }
  .project-card:hover .pj-face {
    transform: translateY(-8px);
    box-shadow: 0 40px 70px -35px rgba(5, 41, 17, 0.55);
  }
  .pj-photo { transition: transform 1.1s cubic-bezier(0.2, 0.7, 0, 1), filter 0.6s; }
  .project-card:hover .pj-photo { transform: scale(1.08); }
  /* a light sweep across the photo on hover */
  .pj-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 65%);
    transform: translateX(-110%);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0, 1);
  }
  .project-card:hover .pj-shade { transform: translateX(110%); }
  .pj-arrow { transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .project-card:hover .pj-arrow { transform: translateX(6px); }

  /* filter flip */
  .project-card.pj-out .pj-face { transform: rotateY(90deg) scale(0.9); opacity: 0; }
  .project-card.pj-in .pj-face { transform: rotateY(-90deg) scale(0.9); opacity: 0; transition: none; }

  /* ---- no photograph yet: a blueprint panel, honest about it ---- */
  .pj-blueprint {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    text-align: center;
    padding: 1.5rem;
    color: #fff;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 24px 24px,
      radial-gradient(80% 90% at 50% 40%, #0c3a1d, #051a0c);
  }
  .pj-bp-icon { font-size: 3.25rem; color: #ff6600; margin-bottom: 0.5rem; transition: transform 0.6s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .project-card:hover .pj-bp-icon { transform: translateY(-4px) scale(1.06); }
  .pj-bp-name { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em; }
  .pj-bp-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .pj-face, .pj-photo, .pj-shade, .pj-arrow, .pj-bp-icon { transition: none !important; }
    .project-card:hover .pj-face, .project-card:hover .pj-photo { transform: none; }
  }
</style>
