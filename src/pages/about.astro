---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, figures } from "../data/company";
import Icon from "../components/Icon.astro";


const values = [
  {
    icon: "verified",
    label: "Square. Plumb. On Layout.",
    body: "Our frames are built to the drawings rather than the eye, so the finish is inspection-ready and passes on the first walk through.",
  },
  {
    icon: "groups",
    label: "Coordinated With Every Trade",
    body: "Our team stays on site alongside the GC, the MEPs, and the inspector through every phase of the build, so the schedule you signed is the schedule we hit.",
  },
  {
    icon: "shield",
    label: "QC & Safety First",
    body: "A strict quality-control program and proven field leadership keep every commercial build on track from pre-construction through final punch.",
  },
];

import LogoBuild from "../components/immersive/LogoBuild.astro";
import MarylandMap from "../components/immersive/MarylandMap.astro";
import CertSeal from "../components/CertSeal.astro";
import ProjectImage from "../components/ProjectImage.astro";
---

<BaseLayout
  title="About"
  description="Nirvana Construction is a commercial drywall and metal-stud framing subcontractor serving Maryland and the Greater Baltimore region. DBE / MBE / SBE certified. Excellence without compromise."
>
  {/* ============ Hero: the logo, built from steel studs ============ */}
  <LogoBuild />

  {/* ============ Who we are ============ */}
  <section class="py-xxl bg-surface-container-low">
    <div class="max-w-container-max mx-auto px-lg grid grid-cols-1 lg:grid-cols-12 gap-xxl">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-sm mb-lg">
          <p class="font-label-bold text-label-bold text-secondary uppercase tracking-widest">
            The Company
          </p>
        </div>
        <h2 data-words class="font-headline-lg text-headline-lg text-primary mb-lg max-w-[32rem]">
          We frame &amp; finish commercial interiors.
        </h2>
        {/* three finished jobs, layered in depth: the stack turns as the
            section scrolls by and leans toward the cursor */}
        <div data-reveal class="mt-xl">
          <div data-stack class="about-stack">
            <div data-z style="--z:0" class="about-card about-card-a">
              <ProjectImage slug="golf-galaxy-night" class="w-full h-full object-cover" sizes="(min-width: 1024px) 24vw, 70vw" alt="A finished Golf Galaxy store lit at night." />
            </div>
            <div data-z style="--z:70" class="about-card about-card-b">
              <ProjectImage slug="chipotle" class="w-full h-full object-cover" sizes="(min-width: 1024px) 20vw, 60vw" alt="A completed Chipotle restaurant exterior." />
            </div>
            <div data-z style="--z:140" class="about-card about-card-c">
              <ProjectImage slug="f45-exterior" class="w-full h-full object-cover" sizes="(min-width: 1024px) 18vw, 55vw" alt="The finished F45 Training studio exterior." />
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 space-y-lg">
        <p data-scrub class="about-lede">
          We frame and finish commercial interiors across the Baltimore region,
          from fast-track tenant fit-outs to large new-build work, backed by
          experienced crews and proven field leadership.
        </p>
        <p data-scrub class="font-body-lg text-body-lg text-on-surface-variant">
          We work the way a good trade partner should: clear communication,
          tight coordination with every other trade, and exactly what was
          drawn: square, plumb, on layout and ready for inspection.
        </p>
        <p data-scrub class="font-body-lg text-body-lg text-on-surface-variant">
          Strict QC and safety standards mean clean installs, accurate
          layouts, and schedules that hold.
        </p>
      </div>
    </div>
  </section>

  {/* ============ Stat counters ============ */}
  <section class="py-xl bg-surface-container-lowest border-y border-outline-variant">
    <div data-depth-in data-depth-stagger class="max-w-container-max mx-auto px-lg grid grid-cols-2 md:grid-cols-4 gap-gutter">
      {figures.map((f, i) => (
        <div class="flex flex-col gap-xs">
          <span
            data-flip={`${f.value}${i === 0 ? "+" : ""}`}
            class="font-headline-lg text-headline-lg text-primary font-bold"
          >
            {`${f.value}${i === 0 ? "+" : ""}`}
          </span>
          <span class="font-label-bold text-label-bold uppercase text-on-surface-variant">
            {f.label}
          </span>
        </div>
      ))}
    </div>
  </section>

  {/* ============ Values / Differentiators ============ */}
  <section class="py-xxl bg-on-background text-white relative overflow-hidden">
    <div class="nv-studs" aria-hidden="true"></div>
    <div class="relative max-w-container-max mx-auto px-lg">
      <div class="max-w-2xl mb-xxl">
        <span class="text-secondary-fixed font-label-bold text-label-bold uppercase tracking-widest mb-md block">
          How we work
        </span>
        <h2 data-words class="font-headline-xl text-headline-xl mb-lg">
          The Nirvana way.
        </h2>
        <p data-reveal class="font-body-lg text-body-lg text-surface-variant">
          We coordinate with the GC, work to the drawings, and finish ready
          for inspection.
        </p>
      </div>
      <div data-depth-in data-depth-stagger data-fan class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {values.map((v) => (
          <div
            data-glow
            class="bg-green-900 border border-on-primary-container/40 p-lg flex flex-col gap-md shadow-2xl"
          >
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center border border-on-primary-container">
              <Icon name={v.icon} class="text-primary-fixed" />
            </div>
            <h4 class="font-label-bold text-label-bold uppercase text-secondary-fixed">
              {v.label}
            </h4>
            <p class="font-body-sm text-body-sm text-white/80">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ Certification ============ */}
  <section class="py-xxl bg-surface-container-low">
    <div class="max-w-container-max mx-auto px-lg grid grid-cols-1 lg:grid-cols-2 gap-xxl items-center">
      {/* the certification is shown by the client's own Maryland MBE seal,
          on the page itself — no plaque behind it */}
      <div data-depth-in class="flex flex-col items-center justify-center gap-md text-center py-lg">
        <CertSeal size={220} class="cert-seal-hero" />
        <p class="label-mono text-green-600">DBE · MBE · SBE · {company.certification.number}</p>
      </div>
      <div class="space-y-lg">
        <div class="flex items-center gap-sm mb-md">
          <p class="font-label-bold text-label-bold text-secondary uppercase tracking-widest">
            Certified
          </p>
        </div>
        <h2 data-words class="font-headline-lg text-headline-lg text-primary">
          Eligible for public &amp; institutional work.
        </h2>
        <p data-reveal class="font-body-lg text-body-lg text-on-surface-variant">
          Nirvana Construction is a DBE / MBE / SBE certified business,
          eligible for Disadvantaged, Minority, and Small Business Enterprise
          participation on public and federally-funded construction projects
          in Maryland.
        </p>
        <p data-reveal class="font-body-md text-on-surface-variant">
          {company.certification.full}
        </p>
      </div>
    </div>
  </section>

  {/* ============ Service area ============ */}
  <section class="py-xxl bg-surface-container-lowest">
    <div class="max-w-container-max mx-auto px-lg grid grid-cols-1 lg:grid-cols-12 gap-xxl items-start">
      {/* the service-area text and city list were removed at the client's
          request; the map and the office card now share the row */}
      <aside class="lg:col-span-12 grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
        <div data-depth-in class="lg:col-span-7">
          <MarylandMap />
        </div>
        <div
          data-depth-in
          data-glow="light"
          class="lg:col-span-5 bg-surface-container border border-outline-variant p-xl"
        >
          <h3 class="font-headline-md text-headline-md mb-md text-primary">
            Where we are
          </h3>
          <div class="space-y-md">
            <div class="flex items-start gap-sm">
              <Icon name="location_on" class="text-secondary mt-px" />
              <p class="font-body-md text-on-surface-variant">
                {company.address.street}<br />
                {company.address.city}, {company.address.state} {company.address.zip}
              </p>
            </div>
            <div class="flex items-start gap-sm">
              <Icon name="schedule" class="text-secondary mt-px" />
              <p class="font-body-md text-on-surface-variant">{company.hours}</p>
            </div>
            <div class="flex items-start gap-sm">
              <Icon name="call" class="text-secondary mt-px" />
              <a
                href={company.phoneHref}
                class="font-body-md text-primary hover:text-secondary transition-colors"
              >
                {company.phone}
              </a>
            </div>
            <div class="flex items-start gap-sm">
              <Icon name="mail" class="text-secondary mt-px" />
              <a
                href={company.emailHref}
                class="font-body-md text-primary hover:text-secondary transition-colors break-all"
              >
                {company.email}
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>


  {/* ============ CTA ============ */}
  <section class="bg-primary text-on-primary py-xxl">
    <div class="max-w-container-max mx-auto px-lg text-center">
      <h2 data-words class="font-headline-lg text-headline-lg mb-md">
        Want us on your next project?
      </h2>
      <p data-reveal class="font-body-lg text-body-lg text-on-primary-container max-w-[36rem] mx-auto mb-xl">
        Send a set of drawings or just a few notes about the scope. We'll be in
        touch within one business day.
      </p>
      <div class="flex flex-col md:flex-row justify-center items-center gap-lg">
        <a
          data-magnetic
          href="/contact/"
          class="inline-flex items-center gap-sm bg-secondary text-on-primary px-xxl py-md font-button text-button uppercase hover:bg-secondary-container hover:text-on-secondary-container transition-all shadow-lg"
        >
          <Icon name="mail" />
          Get in Touch
        </a>
        <a
          href={company.phoneHref}
          class="inline-flex items-center gap-sm border-2 border-on-primary text-on-primary px-xxl py-md font-button text-button uppercase hover:bg-on-primary hover:text-primary transition-all"
        >
          <Icon name="call" />
          {company.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-lede {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }
  .about-stack { position: relative; height: clamp(18rem, 32vw, 24rem); }
  .about-card {
    position: absolute;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--color-hairline);
    box-shadow: 0 40px 70px -35px rgba(5, 41, 17, 0.6);
    background: #e7efe9;
  }
  .about-card-a { left: 0; top: 0; width: 64%; height: 70%; }
  .about-card-b { right: 0; top: 14%; width: 50%; height: 56%; }
  .about-card-c { left: 20%; bottom: 0; width: 46%; height: 48%; border: 4px solid #fff; }
</style>
