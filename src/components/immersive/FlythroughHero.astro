---
/* ============================================================
   FlythroughHero — "Fly through a finished building".

   Replaces the homepage hero and the StudWall3D section. A tall
   scroll track holds a sticky full-viewport canvas; the camera
   leaves the street at dusk, pushes onto the EIFS facade, goes in
   through the front doors, and stops at four stations inside a
   finished fit-out: a cut-away partition (framing, blocking,
   insulation, board), the ACT ceiling, a sector wall, and a final
   lit room with the call to action.

   Engineering:
     · three.js lives in ./flythrough-scene.ts, reached ONLY by
       dynamic import, so it never enters the eager bundle.
     · Progress comes from this section's own getBoundingClientRect —
       lib/motion.ts and its Lenis/ScrollTrigger tick are untouched.
     · The camera is damped toward the scroll target and the loop
       idles the moment it settles.
     · Every word of copy is real HTML. Under reduced motion the
       track collapses to one composed frame with all copy laid out
       statically; with no WebGL the same layout shows a photograph.
   ============================================================ */

import { company, figures } from "../../data/company";
import { trades, services } from "../../data/services";
import Icon from "../Icon.astro";
import ProjectImage from "../ProjectImage.astro";
import { HOTSPOTS, STATIONS } from "./flythrough-timeline";

const bySlug = Object.fromEntries(trades.map((t) => [t.slug, t]));
const eifs = bySlug["eifs"];
const framing = bySlug["metal-framing"];
const carpentry = bySlug["rough-carpentry"];
const insulation = bySlug["insulation"];
const drywall = bySlug["drywall"];
const act = bySlug["acoustical-ceilings"];

/* the trades that live inside the cut-away partition */
const wallTrades = [framing, carpentry, insulation, drywall];

/* hotspot labels pinned to 3D anchors — timing lives in the timeline */
const TRADE_OF: Record<string, string> = {
  eifs: "eifs",
  studs: "metal-framing",
  blocking: "rough-carpentry",
  insulation: "insulation",
  drywall: "drywall",
  act: "acoustical-ceilings",
};
const hotspots = HOTSPOTS.map((h) => ({ ...h, t: bySlug[TRADE_OF[h.id]] }));
const stations = STATIONS;
---

<section class="nv-fly" data-fly aria-label="Nirvana Construction: a walk through a finished building">
  <div class="nv-fly-track">
    <div class="nv-fly-sticky">
      {/* ---------------- media layer ---------------- */}
      <div class="nv-fly-media" aria-hidden="true">
        <div class="nv-fly-dusk"></div>
        <div class="nv-fly-photo">
          <ProjectImage
            slug="f45-exterior"
            alt=""
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <canvas class="nv-fly-canvas" data-fly-canvas></canvas>
        <div class="nv-fly-scrim"></div>
        <div class="nv-fly-rules column-rules"></div>
      </div>

      {/* ---------------- hotspots pinned to the 3D scene ---------------- */}
      <div class="nv-fly-hotspots" aria-hidden="true">
        {
          hotspots.map((h) => (
            <div class="nv-hot" data-hot={h.id}>
              <span class="nv-hot-dot" />
              <span class="nv-hot-line" />
              <span class="nv-hot-card">
                <span class="nv-hot-index">Self-performed</span>
                <span class="nv-hot-title">{h.t.title}</span>
                <span class="nv-hot-blurb">{h.t.blurb}</span>
              </span>
            </div>
          ))
        }
      </div>

      {/* ---------------- copy, one panel per station ---------------- */}
      <div class="nv-fly-stages">
        {/* 00 — street */}
        <div class="nv-stage nv-stage-hero" data-stage="0">
          <div class="nv-stage-hero-inner">
            <h1 class="nv-h1">
              <span class="block" data-words>{company.slogan}</span>
              <span class="block nv-h1-sub" data-words data-delay="0.25">{company.sloganPayoff}.</span>
            </h1>
          </div>
        </div>

        {/* 01 — facade / EIFS */}
        <div class="nv-stage" data-stage="1">
          <p class="label-mono-light mb-sm">EIFS &amp; Exterior Finishes</p>
          <h2 class="nv-h2">{eifs.blurb}</h2>
          <p class="nv-body">{eifs.detail}</p>
        </div>

        {/* 02 — entry */}
        <div class="nv-stage nv-stage-center" data-stage="2">
          <p class="label-mono-light mb-sm">Commercial Fit-Outs</p>
          <h2 class="nv-h2">Step inside the fit-out.</h2>
        </div>

        {/* 03 — the cut-away wall */}
        <div class="nv-stage" data-stage="3">
          <p class="label-mono-light mb-sm">Metal Framing · Blocking · Insulation · Drywall</p>
          <h2 class="nv-h2">Four trades in one partition.</h2>
          <p class="nv-body">
            We frame it, block it, insulate it and board it with our own crews,
            so every layer of the wall answers to one foreman and nothing gets
            lost between trades.
          </p>
          <ul class="nv-static-list">
            {
              wallTrades.map((t) => (
                <li>
                  <strong>{t.title}.</strong> {t.detail}
                </li>
              ))
            }
          </ul>
        </div>

        {/* 04 — ACT ceiling */}
        <div class="nv-stage" data-stage="4">
          <p class="label-mono-light mb-sm">{act.title}</p>
          <h2 class="nv-h2">Level grid, tight to the plan.</h2>
          <p class="nv-body">{act.detail}</p>
        </div>

        {/* 05 — sectors + figures */}
        <div class="nv-stage nv-stage-wide" data-stage="5">
          <p class="label-mono-light mb-sm">Commercial Sectors</p>
          <h2 class="nv-h2">Six sectors, one standard.</h2>
          <dl class="nv-figures">
            {
              figures.slice(0, 3).map((f) => (
                <div>
                  <dt class="label-mono-light">{f.label}</dt>
                  <dd class="nv-figure">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <ul class="nv-sectors">
            {services.map((s) => (
              <li>{s.title}</li>
            ))}
          </ul>
        </div>

        {/* 06 — finished room, CTA */}
        <div class="nv-stage" data-stage="6">
          <p class="label-mono-light mb-sm">{company.slogan}</p>
          <h2 class="nv-h2">Finished, lit and ready to open.</h2>
          <p class="nv-body">
            We hand the space back finished, inspected and ready for the
            tenant's opening day. Tell us about your scope and schedule and
            we'll get back to you within one business day.
          </p>
          <div class="flex flex-wrap items-center gap-md mt-lg">
            <a data-magnetic href="/contact/" class="btn-primary">
              <Icon name="mail" />
              Get in Touch
            </a>
            <a href={company.phoneHref} class="btn-ghost text-white">
              <Icon name="call" />
              {company.phone}
            </a>
          </div>
        </div>
      </div>

      {/* ---------------- station rail + progress ---------------- */}
      <nav class="nv-rail" aria-label="Walkthrough stations">
        <ol>
          {
            stations.map((s) => (
              <li>
                <button type="button" data-goto={s.p}>
                  <span class="nv-rail-l">{s.label}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="nv-progress" aria-hidden="true">
        <span class="nv-progress-fill"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .nv-fly {
    --hdr: 5rem;
    position: relative;
    background: var(--color-green-950);
    color: #fff;
  }
  @media (min-width: 768px) {
    .nv-fly { --hdr: 5.5rem; }
  }

  .nv-fly-track { position: relative; height: 640vh; }
  @media (max-width: 767px) {
    .nv-fly-track { height: 560vh; }
  }

  /* The header is a transparent strip holding a floating pill, so the
     hero slides up under it by exactly its height: the frame is the full
     viewport and the pill floats over the 3D. Static layouts (reduced
     motion / no WebGL) stay in normal flow below the header. */
  .nv-fly:not([data-static]) { margin-top: calc(var(--hdr) * -1); }
  .nv-fly-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .nv-fly:not([data-static]) { margin-top: 0; }
  }

  .nv-fly-media { position: absolute; inset: 0; }
  .nv-fly-dusk {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 30% 78%, rgba(154, 90, 54, 0.45), transparent 70%),
      linear-gradient(180deg, #06120d 0%, #14352a 55%, #2a2520 100%);
  }
  .nv-fly-photo { position: absolute; inset: 0; display: none; }
  .nv-fly-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.06) brightness(0.8);
  }
  .nv-fly[data-nogl] .nv-fly-photo { display: block; }

  .nv-fly-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nv-fly[data-ready] .nv-fly-canvas { opacity: 1; }

  /* legibility: a left wash and a floor wash, never a flat tint */
  .nv-fly-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 26, 12, 0.78) 0%, rgba(5, 26, 12, 0.35) 38%, transparent 62%),
      linear-gradient(0deg, rgba(5, 26, 12, 0.7) 0%, transparent 38%);
  }
  .nv-fly-rules { position: absolute; inset: 0; opacity: 0.07; pointer-events: none; }

  /* ---------------- stages ---------------- */
  .nv-fly-stages {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    pointer-events: none;
  }
  .nv-stage {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: clamp(3.5rem, 9vh, 6rem);
    max-width: 34rem;
    opacity: 0;
    visibility: hidden;
    will-change: opacity, transform;
  }
  .nv-stage[data-on] { pointer-events: auto; }
  /* legibility: each copy block carries its own soft shade, so it reads
     over anything the camera happens to be looking at */
  .nv-stage:not(.nv-stage-hero) { isolation: isolate; }
  .nv-stage:not(.nv-stage-hero)::before {
    content: "";
    position: absolute;
    inset: -3.5rem -5rem -3rem -40vw;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(3, 16, 8, 0.8), rgba(3, 16, 8, 0.45) 55%, transparent);
  }
  .nv-stage-center::before { inset: -4rem -6rem !important; }
  /* headline: a masked rise as its station turns on */
  .nv-stage:not(.nv-stage-hero) .nv-h2 {
    clip-path: inset(0 0 100% 0);
    transform: translateY(0.4em);
    transition: clip-path 0.8s cubic-bezier(0.2, 0.7, 0, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0, 1);
  }
  .nv-stage[data-on] .nv-h2 { clip-path: inset(-0.1em -0.1em -0.25em -0.1em); transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .nv-stage:not(.nv-stage-hero) .nv-h2 { clip-path: none; transform: none; transition: none; }
  }
  .nv-fly[data-static] .nv-stage .nv-h2 { clip-path: none; transform: none; }
  .nv-fly[data-static] .nv-stage::before { display: none; }
  .nv-stage-wide { max-width: 44rem; }
  .nv-stage-center {
    left: 50%;
    right: auto;
    bottom: 50%;
    transform: translate(-50%, 50%);
    text-align: center;
    max-width: 30rem;
    width: calc(100% - 3rem);
  }
  .nv-stage-hero {
    top: 0;
    bottom: 0;
    max-width: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    opacity: 1;
    visibility: visible;
  }
  /* the credentials strip under the buttons was removed at the client's
     request; the buttons keep the breathing room it used to give them */
  .nv-stage-hero-inner { padding-bottom: clamp(2.5rem, 8vh, 5rem); }

  .nv-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 6rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
  .nv-h1-sub { color: rgba(255, 255, 255, 0.62); }
  .nv-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .nv-body {
    margin-top: 0.875rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.76);
    max-width: 30rem;
  }


  .nv-figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .nv-figure {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 0.4rem;
  }
  .nv-sectors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 768px) {
    .nv-sectors { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* shown in the static layout; kept for screen readers otherwise,
     because the 3D hotspots that carry it visually are aria-hidden */
  .nv-static-list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .nv-static-list li { margin-top: 0.75rem; color: rgba(255, 255, 255, 0.76); }
  .nv-static-list strong { color: #fff; font-family: var(--font-display); margin-inline: 0.5rem 0.25rem; }

  /* ---------------- hotspots ---------------- */
  .nv-fly-hotspots { position: absolute; inset: 0; pointer-events: none; }
  .nv-hot {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .nv-hot-dot {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-orange-500);
    box-shadow: 0 0 0 4px rgba(255, 102, 0, 0.22), 0 0 18px rgba(255, 102, 0, 0.55);
  }
  .nv-hot-line {
    position: absolute;
    left: 0;
    top: 0;
    width: 3.25rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.6);
    transform-origin: 0 0;
    transform: rotate(-35deg);
  }
  .nv-hot-card {
    position: absolute;
    left: 2.6rem;
    top: -3.1rem;
    display: block;
    width: 15rem;
    padding: 0.7rem 0.85rem 0.8rem;
    background: rgba(5, 26, 12, 0.62);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 2px solid var(--color-green-500);
  }
  .nv-hot-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .nv-hot-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    margin-top: 0.15rem;
  }
  .nv-hot-blurb {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
    margin-top: 0.2rem;
  }
  .nv-hot[data-flip] .nv-hot-card { left: auto; right: 2.6rem; }
  .nv-hot[data-flip] .nv-hot-line { transform: rotate(-145deg); }
  @media (max-width: 767px) {
    .nv-hot-card { width: 10.5rem; }
    .nv-hot-blurb { display: none; }
  }

  /* ---------------- rail + progress ---------------- */
  .nv-rail {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: none;
  }
  @media (min-width: 1100px) {
    .nv-rail { display: block; }
  }
  .nv-rail ol { display: grid; gap: 0.6rem; }
  .nv-rail button {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.4s ease;
    cursor: pointer;
  }
  .nv-rail button::after {
    content: "";
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.4s ease;
  }
  .nv-rail button:hover { color: rgba(255, 255, 255, 0.8); }
  .nv-rail button[data-active] { color: #fff; }
  .nv-rail button[data-active]::after { width: 2.25rem; background: var(--color-orange-500); }
  .nv-rail-l { opacity: 0; transform: translateX(6px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .nv-rail:hover .nv-rail-l,
  .nv-rail:focus-within .nv-rail-l,
  .nv-rail button[data-active] .nv-rail-l { opacity: 1; transform: none; }
  .nv-rail button:focus-visible { color: #fff; outline: 1px solid var(--color-orange-500); outline-offset: 4px; }

  .nv-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
  }
  .nv-progress-fill {
    position: absolute;
    inset: 0;
    background: var(--color-orange-500);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* ============================================================
     Static layout — reduced motion, or no WebGL. One composed frame
     with the h1 over it, then every station's copy laid out in flow.
     The rules are written twice because a media query and an
     attribute cannot share one selector.
     ============================================================ */
  .nv-fly[data-static] .nv-fly-track { height: auto; }
  .nv-fly[data-static] .nv-fly-sticky { position: relative; top: auto; height: auto; overflow: visible; }
  .nv-fly[data-static] .nv-fly-media { bottom: auto; height: calc(100svh - var(--hdr)); overflow: hidden; }
  .nv-fly[data-static] .nv-fly-stages {
    position: relative;
    inset: auto;
    display: grid;
    gap: 0 3rem;
    padding: 0 1.5rem 4rem;
  }
  .nv-fly[data-static] .nv-stage {
    position: relative;
    inset: auto;
    left: auto;
    right: auto;
    bottom: auto;
    transform: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    max-width: 44rem;
    width: auto;
    text-align: left;
    padding-top: 3rem;
    margin-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    pointer-events: auto;
  }
  .nv-fly[data-static] .nv-stage-hero {
    min-height: calc(100svh - var(--hdr));
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
    max-width: none;
  }
  .nv-fly[data-static] .nv-static-list {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
    white-space: normal;
    margin-top: 1rem;
  }
  .nv-fly[data-static] :is(.nv-fly-hotspots, .nv-rail, .nv-progress) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .nv-fly .nv-fly-track { height: auto; }
    .nv-fly .nv-fly-sticky { position: relative; top: auto; height: auto; overflow: visible; }
    .nv-fly .nv-fly-media { bottom: auto; height: calc(100svh - var(--hdr)); overflow: hidden; }
    .nv-fly .nv-fly-stages {
      position: relative;
      inset: auto;
      display: grid;
      gap: 0 3rem;
      padding: 0 1.5rem 4rem;
    }
    .nv-fly .nv-stage {
      position: relative;
      inset: auto;
      left: auto;
      right: auto;
      bottom: auto;
      transform: none !important;
      opacity: 1 !important;
      visibility: visible !important;
      max-width: 44rem;
      width: auto;
      text-align: left;
      padding-top: 3rem;
      margin-top: 3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      pointer-events: auto;
    }
    .nv-fly .nv-stage-hero {
      min-height: calc(100svh - var(--hdr));
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
      max-width: none;
    }
    .nv-fly .nv-static-list {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      margin-top: 1rem;
    }
    .nv-fly :is(.nv-fly-hotspots, .nv-rail, .nv-progress) { display: none; }
  }
</style>

<script>
  import { getLenis } from "../../lib/motion";
  import type { FlyController, HotspotScreen } from "./flythrough-scene";
  import { STAGES, HOTSPOTS, stageOpacity } from "./flythrough-timeline";

  type Root = HTMLElement & { __flyCleanup?: () => void };

  const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));
  /* probe, then hand the context straight back — a probe per page load must
     not count towards the browser's cap on live WebGL contexts */
  function webglAvailable() {
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2") || c.getContext("webgl");
      gl?.getExtension("WEBGL_lose_context")?.loseContext();
      return !!gl;
    } catch {
      return false;
    }
  }

  function initFly() {
    document.querySelectorAll<Root>("[data-fly]").forEach((root) => {
      root.__flyCleanup?.();

      const track = root.querySelector<HTMLElement>(".nv-fly-track")!;
      const sticky = root.querySelector<HTMLElement>(".nv-fly-sticky")!;
      const canvas = root.querySelector<HTMLCanvasElement>("[data-fly-canvas]")!;
      const stages = [...root.querySelectorAll<HTMLElement>("[data-stage]")];
      const hots = [...root.querySelectorAll<HTMLElement>("[data-hot]")];
      const railBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-goto]")];
      const fill = root.querySelector<HTMLElement>(".nv-progress-fill");

      /* measure the real header so the sticky frame sits flush under it */
      const header = document.querySelector<HTMLElement>("header");
      const setHeader = () => {
        if (header) root.style.setProperty("--hdr", `${header.offsetHeight}px`);
      };
      setHeader();

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hasGL = webglAvailable();
      if (!hasGL) root.setAttribute("data-nogl", "");
      if (reduced || !hasGL) root.setAttribute("data-static", "");
      let isStatic = reduced || !hasGL;

      /* ---------- scroll → progress ---------- */
      const progress = () => {
        const r = track.getBoundingClientRect();
        const travel = r.height - sticky.clientHeight;
        if (travel <= 0) return 0;
        return clamp(-r.top / travel, 0, 1);
      };

      /* ---------- overlays, driven by the DAMPED camera progress ---------- */
      /* one source of truth: flythrough-timeline.ts (unit-tested: never two stages at once) */
      const stageWin = stages.map((el) => STAGES[Number(el.dataset.stage)]);
      const hotWin = hots.map((el) => {
        const h = HOTSPOTS.find((x) => x.id === el.dataset.hot)!;
        return [h.in, h.out] as const;
      });
      const railP = railBtns.map((b) => Number(b.dataset.goto));
      const hero = root.querySelector<HTMLElement>(".nv-stage-hero");
      const heroLinks = hero ? [...hero.querySelectorAll<HTMLElement>("a, button")] : [];
      /* hotspot card widths: measured once, re-measured after a resize —
         reading offsetWidth inside the frame loop forced a layout per card */
      const cardW = new Map<HTMLElement, number>();

      function paint(p: number, hot?: Record<string, HotspotScreen>) {
        if (isStatic) return;
        stages.forEach((el, i) => {
          const v = stageOpacity(p, stageWin[i]);
          const lift = (1 - v) * 18;
          el.style.opacity = v.toFixed(3);
          if (el === hero) {
            /* the h1 stays in the accessibility tree after it fades, so
               heading navigation still finds it; only its links step out */
            heroLinks.forEach((a) => (a.inert = v < 0.5));
          } else {
            el.style.visibility = v < 0.01 ? "hidden" : "visible";
            /* faded copy must not take keyboard focus */
            el.inert = v < 0.5;
          }
          const base = el.classList.contains("nv-stage-center") ? "translate(-50%, 50%) " : "";
          el.style.transform = `${base}translate3d(0, ${lift.toFixed(1)}px, 0)`;
          v > 0.5 ? el.setAttribute("data-on", "") : el.removeAttribute("data-on");
        });

        hots.forEach((el, i) => {
          const id = el.dataset.hot!;
          const s = hot?.[id];
          const [a, b] = hotWin[i];
          const v = s && s.visible ? stageOpacity(p, [a, b]) : 0;
          el.style.opacity = v.toFixed(3);
          el.style.visibility = v < 0.01 ? "hidden" : "visible";
          if (s && v > 0) {
            /* keep the card on screen: flip it left near the right edge */
            const w = sticky.clientWidth;
            el.style.transform = `translate3d(${s.x.toFixed(1)}px, ${s.y.toFixed(1)}px, 0)`;
            /* place the card on whichever side has room; if neither side
               fits (phones), nudge it back inside the frame */
            const card = el.querySelector<HTMLElement>(".nv-hot-card")!;
            if (!cardW.has(card)) cardW.set(card, card.offsetWidth);
            const need = cardW.get(card)! + 52;
            /* keep clear of the station rail on wide screens */
            const rail = w >= 1024 ? 150 : 0;
            const right = w - rail - s.x;
            const flip = right < need && s.x > right;
            el.toggleAttribute("data-flip", flip);
            const nudge = flip ? Math.max(0, need - s.x) : Math.min(0, right - need);
            card.style.translate = `${nudge.toFixed(0)}px 0`;
          }
        });

        let active = 0;
        railP.forEach((rp, i) => {
          if (p >= rp - 0.06) active = i;
        });
        railBtns.forEach((b, i) => b.toggleAttribute("data-active", i === active));
        if (fill) fill.style.transform = `scaleX(${p.toFixed(4)})`;
      }

      /* ---------- rail: jump to a station; the damped camera flies there ---------- */
      const onRail = (e: Event) => {
        const b = (e.currentTarget as HTMLElement).dataset.goto;
        const r = track.getBoundingClientRect();
        const travel = r.height - sticky.clientHeight;
        const y = window.scrollY + r.top + Number(b) * travel;
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(y, { duration: 1.4 });
        else window.scrollTo({ top: y });
      };
      railBtns.forEach((b) => b.addEventListener("click", onRail));

      let ctl: FlyController | null = null;
      let disposed = false;
      let raf = 0;

      const onScroll = () => {
        if (ctl) {
          ctl.kick();
        } else if (!raf) {
          raf = requestAnimationFrame(() => {
            raf = 0;
            paint(progress());
          });
        }
      };
      let rz = 0;
      const onResize = () => {
        cancelAnimationFrame(rz);
        rz = requestAnimationFrame(() => {
          setHeader();
          cardW.clear();
          ctl?.resize();
          ctl?.kick();
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize);
      paint(progress());

      /* ---------- fallback: one place that leaves NOTHING driving the copy ----------
         If the 3D fails after the tall track was laid out, the stages go back
         to plain static content: painter off, listeners off, and every inline
         opacity / visibility / transform / inert cleared. */
      const goStatic = () => {
        isStatic = true;
        root.setAttribute("data-nogl", "");
        root.setAttribute("data-static", "");
        window.removeEventListener("scroll", onScroll);
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        heroLinks.forEach((a) => (a.inert = false));
        [...stages, ...hots].forEach((el) => {
          el.inert = false;
          el.removeAttribute("data-on");
          el.style.removeProperty("opacity");
          el.style.removeProperty("visibility");
          el.style.removeProperty("transform");
        });
      };

      /* ---------- the 3D layer: fetched straight away, off the eager path ---------- */
      if (hasGL) {
        const lite = window.matchMedia("(max-width: 820px), (pointer: coarse)").matches;
        import("./flythrough-scene")
          .then(({ createFlythrough }) =>
            createFlythrough({
              canvas,
              host: sticky,
              lite,
              getTarget: progress,
              onFrame: paint,
              still: isStatic ? 1 : undefined,
            }),
          )
          .then((c) => {
            if (disposed) {
              c?.dispose();
              return;
            }
            if (!c) return goStatic();
            ctl = c;
            if (import.meta.env.DEV) (window as unknown as { __nvFly?: FlyController }).__nvFly = c;
            root.setAttribute("data-ready", "");
            ctl.kick();
          })
          .catch(goStatic);
      }

      root.__flyCleanup = () => {
        disposed = true;
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onResize);
        railBtns.forEach((b) => b.removeEventListener("click", onRail));
        if (raf) cancelAnimationFrame(raf);
        ctl?.dispose();
        ctl = null;
        root.removeAttribute("data-ready");
        delete root.__flyCleanup;
      };
    });
  }

  document.addEventListener("astro:page-load", initFly);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<Root>("[data-fly]").forEach((r) => r.__flyCleanup?.());
  });
</script>
