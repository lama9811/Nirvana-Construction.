---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  /* where "Skip to content" lands — a page whose job is one thing
     (the contact form) can point it straight there */
  skipTo?: string;
  skipLabel?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image,
  skipTo = "#main",
  skipLabel = "Skip to content",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Typefaces are self-hosted from /public/fonts and declared in
      global.css — no Google Fonts requests, and no Material Symbols
      variable font (icons are inline SVG via components/Icon.astro).
      Only the three faces needed for first paint are preloaded.
    */}
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <SEO title={title} description={description} path={path} image={image} />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
  </head>
  <body class="bg-surface text-on-surface font-body-md selection:bg-secondary-fixed selection:text-on-secondary-fixed">
    <a href={skipTo} class="skip-link">{skipLabel}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      body {
        font-family: var(--font-body-md);
      }
      .skip-link {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--color-secondary-container);
        /* dark label: white on the logo orange is 2.94:1 and fails */
        color: var(--color-on-secondary-container);
        font-weight: 600;
        font-size: 0.85rem;
        transform: translateY(-120%);
        transition: transform 0.25s ease-out;
      }
      .skip-link:focus { transform: translateY(0); }
    </style>

    {/* Declarative motion backbone — runs initMotion on every navigation */}
    <script>
      import { initMotion, destroyMotion } from "../lib/motion";
      document.addEventListener("astro:page-load", initMotion);
      document.addEventListener("astro:before-swap", destroyMotion);
    </script>

    {/* Depth layer — perspective tilt-ins, flip counters, cursor glow (lib/depth.ts) */}
    <script>
      import { initDepth } from "../lib/depth";
      let depthCleanup: (() => void) | null = null;
      document.addEventListener("astro:page-load", () => {
        depthCleanup?.();
        depthCleanup = initDepth();
      });
      document.addEventListener("astro:before-swap", () => {
        depthCleanup?.();
        depthCleanup = null;
      });
    </script>
  </body>
</html>
