---
import BaseLayout from "../layouts/BaseLayout.astro";


import XrayWall from "../components/immersive/XrayWall.astro";
import TradeDeck from "../components/services/TradeDeck.astro";
import SectorDrift from "../components/services/SectorDrift.astro";
import ProcessPath from "../components/services/ProcessPath.astro";
import ScopeDrum from "../components/services/ScopeDrum.astro";
import { company } from "../data/company";
import CertSeal from "../components/CertSeal.astro";
---

<BaseLayout
  title="Services"
  description="Commercial drywall, metal-stud framing, acoustical ceilings, insulation and finishing: Nirvana Construction's full scope of work for Maryland's general contractors."
>
  {/* ============ Hero: the exploded wall — six trades, layer by layer ============ */}
  <XrayWall />

  <div class="max-w-container-max mx-auto px-lg py-xxl grid grid-cols-1 lg:grid-cols-12 gap-xxl">
    {/* Main content */}
    <div class="lg:col-span-12 space-y-xxl">
      {/* Trades, sectors and process: 3D motion sections (components/services/) */}
      <TradeDeck />
      <SectorDrift />
      <ProcessPath />

      <ScopeDrum />

      {/* Certification — the client's Maryland MBE seal */}
      <section id="certification">
        <div data-depth-in data-glow="light" class="flex flex-col sm:flex-row items-center gap-xl bg-surface-container-lowest border border-outline-variant p-xl">
          <CertSeal size={132} />
          <div class="text-center sm:text-left">
            <p class="font-label-bold text-label-bold uppercase text-secondary tracking-widest mb-xs">
              Certified
            </p>
            <h2 class="font-headline-lg text-headline-lg text-primary mb-sm">DBE · MBE · SBE</h2>
            <p class="font-body-md text-on-surface-variant max-w-[36rem]">
              We're certified through Maryland's Office of Minority Business Enterprise,
              so our work counts toward Disadvantaged, Minority and Small Business
              participation goals on public and institutional projects.
            </p>
            <p class="label-mono text-green-600 mt-md">{company.certification.number}</p>
          </div>
        </div>
      </section>
    </div>

  </div>
</BaseLayout>
