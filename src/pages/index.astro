---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  company,
  figures,
  certifications,
  generalContractors,
} from "../data/company";
import Icon from "../components/Icon.astro";
import Marquee from "../components/Marquee.astro";
import ProjectImage from "../components/ProjectImage.astro";
import FlythroughHero from "../components/immersive/FlythroughHero.astro";

/* Four certifications is a short loop, so the strip is fed each label
   twice — the marquee still reads as a continuous run rather than a
   visibly short list snapping back. */
const certLabels =
  certifications.length < 6
    ? [...certifications, ...certifications].map((c) => c.label)
    : certifications.map((c) => c.label);
---

<BaseLayout
  title="Commercial Drywall & Metal-Stud Framing"
  description="Nirvana Construction Inc., commercial drywall and metal-stud framing subcontractor serving the Greater Baltimore region. DBE / MBE / SBE certified."
>
  {/* ============ Immersive hero: fly through a finished building ============
      Replaces the photographic hero AND the StudWall3D section. The
      cut-away partition inside the building now carries the "how a
      wall goes up" story. See src/components/immersive/. */}
  <FlythroughHero />

  {/* ============ General contractors we work with ============
      The whole band is conditional, not just the strip — otherwise an
      empty GC list would leave a bordered, padded gap on the page. */}
  {
    generalContractors.length > 0 && (
      <section class="py-xl bg-surface-container-low border-b border-outline-variant">
        <div class="max-w-container-max mx-auto px-lg">
          <Marquee
            label="General contractors we work with"
            items={generalContractors.map((g) => g.name)}
            tone="light"
          />
        </div>
      </section>
    )
  }

  {/* ============ The Nirvana Difference ============ */}
  <section class="nv-diff py-xxl bg-on-background text-white relative overflow-hidden">
    {/* a stud layout at 16" o.c. drifting slowly behind the band */}
    <div class="nv-studs" aria-hidden="true"></div>
    <div class="relative max-w-container-max mx-auto px-lg grid grid-cols-1 lg:grid-cols-2 gap-xxl items-center">
      <div class="reveal">
        <span class="text-secondary-fixed font-label-bold text-label-bold uppercase tracking-widest mb-md block">
          Why Choose Us
        </span>
        <h2 class="font-headline-xl text-headline-xl mb-lg">The Nirvana Difference</h2>
        <p data-scrub class="font-body-lg text-body-lg text-surface-variant mb-xl">
          We coordinate closely with the general contractor, work straight to
          the drawings, and finish ready for inspection so every plate is
          plumb, every stud is on layout, and the drywall is clean enough to
          disappear under paint.
        </p>
        <div data-depth-in data-depth-stagger class="space-y-lg">
          <div data-glow class="nv-point flex gap-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center shrink-0 border border-on-primary-container">
              <Icon name="verified" class="text-primary-fixed" />
            </div>
            <div>
              <h4 class="font-label-bold text-label-bold uppercase text-secondary-fixed mb-xs">
                Square. Plumb. On Layout.
              </h4>
              <p class="text-white/80 font-body-sm">
                Our frames are built to the drawings rather than the eye,
                so the finish is inspection-ready and passes on the first
                walk through.
              </p>
            </div>
          </div>
          <div data-glow class="nv-point flex gap-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center shrink-0 border border-on-primary-container">
              <Icon name="groups" class="text-primary-fixed" />
            </div>
            <div>
              <h4 class="font-label-bold text-label-bold uppercase text-secondary-fixed mb-xs">
                Coordinated With Every Trade
              </h4>
              <p class="text-white/80 font-body-sm">
                Our team stays on site alongside the GC, the MEPs, and the
                inspector through every phase of the build, so the schedule
                you signed is the schedule we hit.
              </p>
            </div>
          </div>
          <div data-glow class="nv-point flex gap-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center shrink-0 border border-on-primary-container">
              <Icon name="shield" class="text-primary-fixed" />
            </div>
            <div>
              <h4 class="font-label-bold text-label-bold uppercase text-secondary-fixed mb-xs">
                {company.certification.label}
              </h4>
              <p class="text-white/80 font-body-sm">
                We hold {company.certification.number} and run a strict QC and
                safety program on every commercial build we touch.
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* the wall: three site boards hung on a framed wall, the count as a
          solid block in front; the whole assembly turns as it scrolls by and
          leans toward the cursor (data-stack), each piece at its own depth */}
      <div data-reveal>
        <div data-stack class="nv-wall">
          <div data-z style="--z:-150" class="nv-wall-frame" aria-hidden="true"></div>
          <div data-z style="--z:-130" class="nv-wall-laser" aria-hidden="true"></div>
          <figure data-z style="--z:0" class="nv-board nv-board-a nv-solid">
            <div class="nv-board-img">
              <img
                class="w-full h-full object-cover"
                src="/images/projects/jobsite-05.webp"
                srcset="/images/projects/jobsite-05-800.webp 800w, /images/projects/jobsite-05.webp 1600w"
                sizes="(min-width: 1024px) 26vw, 55vw"
                alt="Commercial Nirvana Construction jobsite nearing completion."
                loading="lazy"
              />
            </div>
            <figcaption class="nv-board-tag">On site</figcaption>
          </figure>
          <figure data-z style="--z:70" class="nv-board nv-board-b nv-solid">
            <div class="nv-board-img">
              <ProjectImage
                slug="panda-express"
                class="w-full h-full object-cover"
                sizes="(min-width: 1024px) 20vw, 45vw"
                alt="A completed Panda Express restaurant at dusk, with finished cladding, soffits and a lit entrance canopy."
              />
            </div>
            <figcaption class="nv-board-tag">Panda Express</figcaption>
          </figure>
          <figure data-z style="--z:120" class="nv-board nv-board-c nv-solid">
            <div class="nv-board-img">
              <ProjectImage
                slug="golf-galaxy-night"
                class="w-full h-full object-cover"
                sizes="(min-width: 1024px) 20vw, 45vw"
                alt="A finished Golf Galaxy store lit at night."
              />
            </div>
            <figcaption class="nv-board-tag">Golf Galaxy</figcaption>
          </figure>
        </div>
      </div>

    </div>

      {/* ---- running certification strip ----
           Sits OUTSIDE the two-column grid above; as a direct grid
           child it became a 584px cell instead of spanning the band. */}
      <div data-reveal class="relative max-w-container-max mx-auto px-lg mt-xxl pt-xl border-t border-white/15">
        <Marquee label="Certifications" items={certLabels} tone="dark" />
      </div>
  </section>

</BaseLayout>

<style>
  /* ---- "The Nirvana Difference": the wall ---- */
  .nv-wall {
    position: relative;
    height: clamp(22rem, 38vw, 34rem);
    margin-inline: 4%;
  }
  .nv-wall-frame {
    position: absolute;
    inset: -8% -14%;
    border-top: 5px solid rgba(185, 205, 191, 0.55);
    border-bottom: 5px solid rgba(185, 205, 191, 0.55);
    background: repeating-linear-gradient(90deg, rgba(185, 205, 191, 0.42) 0 3px, transparent 3px 36px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .nv-wall-laser {
    position: absolute;
    left: -16%;
    right: -16%;
    top: 56%;
    height: 2px;
    background: #ff6600;
    box-shadow: 0 0 16px 3px rgba(255, 102, 0, 0.55);
  }
  /* a solid: two side faces so the piece has thickness whichever way the wall turns */
  .nv-solid { --t: 18px; transform-style: preserve-3d; }
  .nv-solid::before,
  .nv-solid::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--t);
    background: var(--side, #17301f);
  }
  .nv-solid::before { left: 100%; transform-origin: 0 50%; transform: rotateY(90deg); }
  .nv-solid::after { right: 100%; transform-origin: 100% 50%; transform: rotateY(-90deg); }
  .nv-board {
    position: absolute;
    margin: 0;
    background: #17301f;
    box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .nv-board-img { position: absolute; inset: 0; overflow: hidden; }
  .nv-board-img img {
    filter: grayscale(1);
    transition: filter 0.7s, transform 1.2s cubic-bezier(0.2, 0.7, 0, 1);
  }
  .nv-board:hover .nv-board-img img { filter: none; transform: scale(1.06); }
  .nv-board-tag {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(5, 26, 12, 0.7);
    padding: 0.3rem 0.55rem;
  }
  .nv-board-a { left: 0; top: 0; width: 58%; height: 52%; }
  .nv-board-b { right: 0; top: 14%; width: 44%; height: 68%; }
  .nv-board-c { left: 22%; bottom: 0; width: 46%; height: 42%; }
  /* the three points, as glass cards the cursor lights */
  .nv-point {
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0.5rem;
  }
</style>
